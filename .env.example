# Smart Canteen - database settings (copy these into your real environment, never commit real values)
#
# The Java code (util/DBConnection.java) reads these three environment variables.
# On Windows + Tomcat the easiest way is to put them in  <tomcat>\bin\setenv.bat :
#     set DB_URL=jdbc:mysql://localhost:3306/smart_canteen?useSSL=false^&allowPublicKeyRetrieval=true
#     set DB_USERNAME=canteen_user
#     set DB_PASSWORD=your_password_here

DB_URL=jdbc:mysql://localhost:3306/smart_canteen?useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=
DB_PASSWORD=
