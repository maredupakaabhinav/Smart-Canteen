# Smart Canteen on Vercel (Container Images, beta).
# Vercel builds this file and runs the image as a Function that must listen on port 80.
#
# Stage 1: compile the project and build the WAR with Maven
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -B -q clean package -DskipTests

# Stage 2: run the WAR on Tomcat 10.1
FROM tomcat:10.1-jre17-temurin

# - empty webapps folder, so the app is served at "/" (ROOT.war)
# - Tomcat listens on port 80 (the port Vercel expects)
# - RemoteIpValve: Vercel talks to Tomcat over plain HTTP, so Tomcat reads X-Forwarded-Proto
#   to know the visitor used https (correct redirect addresses + Secure cookie)
RUN rm -rf /usr/local/tomcat/webapps/* \
 && sed -i 's/port="8080"/port="80"/' /usr/local/tomcat/conf/server.xml \
 && sed -i 's#</Host>#  <Valve className="org.apache.catalina.valves.RemoteIpValve" internalProxies=".*" protocolHeader="X-Forwarded-Proto" />\n      </Host>#' /usr/local/tomcat/conf/server.xml

COPY --from=build /build/target/smartcanteen.war /usr/local/tomcat/webapps/ROOT.war

# The database settings (DB_URL, DB_USERNAME, DB_PASSWORD) are NOT in this image:
# they are environment variables set in the Vercel project settings.
ENV JAVA_OPTS="-XX:MaxRAMPercentage=70 -Djava.security.egd=file:/dev/urandom"
EXPOSE 80
CMD ["catalina.sh", "run"]
