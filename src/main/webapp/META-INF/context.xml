<?xml version="1.0" encoding="UTF-8"?>
<!-- Tomcat-specific settings for this web application -->
<Context>
    <!-- The session cookie is not sent with requests that come from other websites (helps against CSRF) -->
    <CookieProcessor className="org.apache.tomcat.util.http.Rfc6265CookieProcessor" sameSiteCookies="lax" />
</Context>
